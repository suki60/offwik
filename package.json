{
  "name": "wiki-rag",
  "version": "1.0.0",
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc && tsc -p tsconfig.web.json",
    "format": "biome check --write .",
    "setup": "npm run download && npm run load && npm run embed && npm run index && npm run export",
    "download": "tsx src/setup/download.ts",
    "load": "tsx src/setup/load.ts",
    "embed": "tsx src/setup/embed.ts",
    "index": "tsx src/setup/index.ts",
    "export": "tsx src/setup/export.ts",
    "rag-eval": "tsx src/eval/rag-eval.ts",
    "embed-parity": "tsx src/eval/embed-parity.ts",
    "search-eval": "tsx src/eval/search-eval.ts",
    "dev": "vite"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.2",
    "@huggingface/transformers": "^4.3.2",
    "@mlc-ai/web-llm": "^0.2.86",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
