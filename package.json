{
  "name": "wiki-rag",
  "version": "1.0.0",
  "scripts": {
    "download": "mkdir -p data && curl -L --fail -o data/simple.parquet https://huggingface.co/datasets/wikimedia/wikipedia/resolve/main/20231101.simple/train-00000-of-00001.parquet",
    "lint": "biome check .",
    "typecheck": "tsc",
    "format": "biome check --write .",
    "load": "tsx src/load.ts",
    "embed": "tsx src/embed.ts",
    "search": "tsx src/search.ts",
    "index": "tsx src/index.ts",
    "closed-book": "tsx src/closed-book.ts",
    "eval": "tsx src/eval.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
